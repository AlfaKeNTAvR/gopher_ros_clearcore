<?xml version="1.0"?>
<launch>=

    <!-- ============================ SETTINGS ============================= -->

    <!-- Node frequency: the frequency [Hz] which rate.sleep() function will
    attempt to maintain in the main_loop. -->
    <arg 
    name="node_frequency" 
    default="100"/>

    <!-- Start position: move chest to starting position [meters]: [0.0 - 0.44].
    If set to -1, no starting position is set and the chest stays at current
    position. -->
    <arg 
    name="start_position" 
    default="-1"/>

    <!-- ======================== END OF SETTINGS ========================== -->


    <!-- Chest serial module: -->
    <node 
    pkg="gopher_ros_clearcore" 
    type="chest_serial.py" 
    name="chest_serial" 
    output="screen">
        <param 
        name="node_frequency" 
        value="$(arg node_frequency)"/>
    </node>

    <!-- Chest logger module: --> 
    <node 
    pkg="gopher_ros_clearcore" 
    type="chest_logger.py" 
    name="chest_logger" 
    output="screen">
        <param 
        name="node_frequency" 
        value="$(arg node_frequency)"/>
    </node>
    
    <!-- Chest control module: --> 
    <node 
    pkg="gopher_ros_clearcore" 
    type="chest_control.py" 
    name="chest_control" 
    output="screen">
        <param 
        name="node_frequency" 
        value="$(arg node_frequency)"/>
        <param 
        name="start_position" 
        value="$(arg start_position)"/>
    </node>   

    <!-- Static frames broadcasters: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="stand_link_broadcaster" 
    args="0 0 0.36 0 0 0 1 base_link stand_link"
    />

    <!-- Torso top plate: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="top_plate_broadcaster" 
    args="0 0 0.335 0 0 0 1 torso_bottom_plate torso_top_plate"
    />

    <!-- Arm mount frames: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_torso_mount_broadcaster" 
    args="0 -0.104 0.026 0 0 2.35619 torso_top_plate right_arm/torso_mount"
    />

    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_torso_mount_broadcaster" 
    args="0 0.104 0.026 0 0 -2.35619 torso_top_plate left_arm/torso_mount"
    />

    <!-- Arm links: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_arm_mount_broadcaster" 
    args="0 0 0 1.57 0 0 right_arm/torso_mount right_arm/base_link"
    />

    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_arm_mount_broadcaster" 
    args="0 0 0 -1.57 0 0 left_arm/torso_mount left_arm/base_link"
    />
</launch>
